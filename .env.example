# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:user:password@db.xxxxxx.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:user:password@db.xxxxxx.supabase.co:5432/postgres?schema=public"

# Session & JWT Security
JWT_SECRET="replace-with-secure-random-32-byte-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="wa-media"
